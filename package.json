    "@ui-sdk/react": "0.1.0-beta.17",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.426.0",
    "mongodb": "^6.21.0",
    "next": "^16.4.6",
    "next-themes": "^0.4",
