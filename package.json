{
  "name": "tokei",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "create-indexes": "pnpm exec gulp create-indexes",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "prettify": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "pnpm exec playwright test",
    "ci": "prettier --check . && pnpm exec tsc --noEmit && CI=true pnpm run test --watchAll=false",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "run-local-mongo": "brew services start mongodb-community@8.0",
    "stop-local-mongo": "brew services stop mongodb-community@8.0"
  },
